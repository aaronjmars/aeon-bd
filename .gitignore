# macOS
.DS_Store

# Secrets & local env
.env
.env.local
.env.*.local

# Claude Code local state
.claude/

# Caches — prefetch scripts write these, skills read them; regenerated every run
# (.xai-cache, .treasury-cache, .star-cache, .github-releases-cache, …)
.*-cache/
.tg_cache/

# Working scratch dirs some skills stage during a run, then clean up:
# .pending-notify (notify re-delivery), .pending-deploy (deploy-prototype build),
# plus .pending-notify-temp where skills stage notify bodies for `./notify -f`
.pending-*/

# Skill provenance lock (per-repo, not committed)
skills.lock

# Scratch / temp files
tmp_*
*.tmp
.tmp-*
.pending-*.sh
.run-*.sh
.*-tmp.md
.*-draft.md
.*-msg.txt
*_msg.txt
*_raw.txt

# Leaked creds scratch
.xai_key
.ghtoken

# Python bytecode
__pycache__/
*.pyc

# Node
node_modules/

# Stale artifacts
.external-work
.vuln-scan/

# --- Leaked skill run scratch (belongs in /tmp; skills stage under /tmp per their SKILL.md) ---
# Root-anchored so legit output/articles/bd-radar-*.md, memory/topics/bd-radar-leads.json,
# and skills/bd-radar/ are never caught.
/bd-*.py
/bd_*.py
/bd-*.json
/bd_*.json
/bd-*.md
/bd-temp/
/.bd-radar-scratch/
/update_bd_leads.py
/xai-*.json
/.xai-*.json
/shiplog-notify.md
/tweet-roundup-notify.md
/.bd-radar-notify-*.md
/.competitor-radar-notify-*.md
/.mention-radar-*.md
/.sim-watch-notify.md
# hyphen-form temp scratch (existing rule only ignores tmp_*)
tmp-*
# interior scratch recurrence guards
memory/topics/xai-*.json
output/xai-*.json
output/.xai-*.json
# canon parity
.pending-*.md
apps/dashboard/outputs/.pending-*.md
