        "text": "Next Priority #1 resolved, no manual action needed"
      }
    },
    "sep3": {
      "type": "Separator",
      "props": {}
    },
    "new-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
