      "type": "Text",
      "props": {
        "text": "static capability classes are brittle — nodes evolve. better than classify-at-deploy: capability negotiation on-demand. node declares what it can do per-request; router matches live. class matching is a snapshot, not a truth.",
        "variant": "body"
      }
