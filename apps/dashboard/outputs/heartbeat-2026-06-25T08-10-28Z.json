{
  "root": "card_main",
  "state": {},
  "elements": {
    "card_main": {
      "type": "Card",
      "props": {
        "title": "Heartbeat — Morning Batch Status"
      },
      "children": [
        "alert_p3",
        "sep_1",
        "failed_batch_section",
        "sep_2",
        "investigation_section",
        "sep_3",
        "status_section"
      ]
    },
    "alert_p3": {
      "type": "Alert",
      "props": {
        "title": "🟡 P3 — WATCH: Morning batch missed 2 days",
        "type": "warning"
      }
    },
    "sep_1": {
      "type": "Separator",
      "props": {}
    },
    "failed_batch_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "batch_heading",
        "batch_timing_text",
        "threshold_text",
        "failed_badges"
      ]
    },
    "batch_heading": {
      "type": "Heading",
      "props": {
        "text": "Failed Batch",
        "level": "h3"
      }
    },
    "batch_timing_text": {
      "type": "Text",
      "props": {
        "text": "product-pulse · bd-radar · war-room · engagement-act last succeeded 2026-06-23 07:38–10:07 UTC (~49h ago)",
        "variant": "body"
      }
    },
    "threshold_text": {
      "type": "Text",
      "props": {
        "text": "Daily threshold is 2× = 48h",
        "variant": "muted"
      }
    },
    "failed_badges": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "badge_pulse",
        "badge_radar",
        "badge_warroom",
        "badge_engagement"
      ]
    },
    "badge_pulse": {
      "type": "Badge",
      "props": {
        "text": "product-pulse",
        "variant": "destructive"
      }
    },
    "badge_radar": {
      "type": "Badge",
      "props": {
        "text": "bd-radar",
        "variant": "destructive"
      }
    },
    "badge_warroom": {
      "type": "Badge",
      "props": {
        "text": "war-room",
        "variant": "destructive"
      }
    },
    "badge_engagement": {
      "type": "Badge",
      "props": {
        "text": "engagement-act",
        "variant": "destructive"
      }
    },
    "sep_2": {
      "type": "Separator",
      "props": {}
    },
    "investigation_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "inv_heading",
        "dispatch_alert",
        "working_skills_heading",
        "working_badges",
        "pr_subsection"
      ]
    },
    "inv_heading": {
      "type": "Heading",
      "props": {
        "text": "Investigation",
        "level": "h3"
      }
    },
    "dispatch_alert": {
      "type": "Alert",
      "props": {
        "message": "No dispatches logged for June 24 or June 25",
        "type": "info"
      }
    },
    "working_skills_heading": {
      "type": "Heading",
      "props": {
        "text": "Other skills — running normally yesterday",
        "level": "h4"
      }
    },
    "working_badges": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "badge_fetch",
        "badge_write",
        "badge_reply",
        "badge_buzz",
        "badge_shiplog",
        "badge_forge"
      ]
    },
    "badge_fetch": {
      "type": "Badge",
      "props": {
        "text": "fetch-tweets",
        "variant": "secondary"
      }
    },
    "badge_write": {
      "type": "Badge",
      "props": {
        "text": "write-tweet",
        "variant": "secondary"
      }
    },
    "badge_reply": {
      "type": "Badge",
      "props": {
        "text": "reply-maker",
        "variant": "secondary"
      }
    },
    "badge_buzz": {
      "type": "Badge",
      "props": {
        "text": "agent-buzz",
        "variant": "secondary"
      }
    },
    "badge_shiplog": {
      "type": "Badge",
      "props": {
        "text": "daily-shiplog",
        "variant": "secondary"
      }
    },
    "badge_forge": {
      "type": "Badge",
      "props": {
        "text": "idea-forge",
        "variant": "secondary"
      }
    },
    "pr_subsection": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "pr_heading",
        "pr_stack"
      ]
    },
    "pr_heading": {
      "type": "Heading",
      "props": {
        "text": "Related open PR",
        "level": "h4"
      }
    },
    "pr_stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "pr_link",
        "pr_context"
      ]
    },
    "pr_link": {
      "type": "Link",
      "props": {
        "label": "PR #13 — chore: reduce GitHub Actions minutes",
        "href": "https://github.com/aaronjmars/aeon-nur/pull/13"
      }
    },
    "pr_context": {
      "type": "Text",
      "props": {
        "text": "Open/unmerged, 17h old — not the cause",
        "variant": "muted"
      }
    },
    "sep_3": {
      "type": "Separator",
      "props": {}
    },
    "status_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "status_heading",
        "status_text"
      ]
    },
    "status_heading": {
      "type": "Heading",
      "props": {
        "text": "Status",
        "level": "h3"
      }
    },
    "status_text": {
      "type": "Text",
      "props": {
        "text": "Status page updated → 🟡 WATCH",
        "variant": "body"
      }
    }
  }
}
