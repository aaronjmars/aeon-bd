    "text-reply-a-1": {
      "type": "Text",
      "props": {
        "text": "the temporal axis converges — every model strips the same crutches. the one that compounds is self-modification: a harness that rewrites & merges its own skills against your data. that's the moat, not the next 10% on a bench",
        "variant": "body"
