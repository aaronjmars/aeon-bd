    "tweetcard-4": {
      "type": "TweetCard",
      "props": {
        "author": "Milk Road",
        "handle": "MilkRoad",
        "text": "Coinbase launched Agentic.Market — the 'homepage of the agent economy'… the moment agents need to pay, they hit a wall"
      }
    },
    "why-4": {
      "type": "Text",
      "props": {
        "text": "Why: agent-economy explainer to a big audience — reframe the wall from payments → persistence",
        "variant": "lead"
      }
    },
    "reply-a-4": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "badge-reply-a-4",
        "text-reply-a-4"
      ]
    },
    "badge-reply-a-4": {
      "type": "Badge",
      "props": {
        "text": "A",
        "variant": "default"
      }
    },
    "text-reply-a-4": {
      "type": "Text",
      "props": {
        "text": "the payment wall is the easy half. the hard one is persistence: an agent needs verifiable credentials (github is the strongest layer), inference it can pay forever, and credit when short — aave lines repay in ~30s. payments without persistence is a bot that dies on friday.",
        "variant": "body"
      }
    },
    "reply-b-4": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "badge-reply-b-4",
        "text-reply-b-4"
      ]
    },
    "badge-reply-b-4": {
      "type": "Badge",
      "props": {
        "text": "B",
        "variant": "secondary"
      }
    },
    "text-reply-b-4": {
      "type": "Text",
      "props": {
        "text": "the framing buries the real wall. agents aren't 'good at doing things' yet — they're good at doing one thing while watched. the bottleneck isn't checkout, it's running unattended without breaking. solve autonomy first; the payment rail is the trivial part. cron is trivial.",
        "variant": "body"
      }
    },
