    "text-reply-b-1": {
      "type": "Text",
      "props": {
        "text": "'simplify as models improve' assumes the harness is just scaffolding for model weakness. it's not. the parts that survive better models are the autonomous ones — cron, self-repair, memory. those don't get stripped, they compound. the harness is the model.",
        "variant": "body"
      }
