{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "product-pulse"
      },
      "children": [
        "alert-ci",
        "sep-1",
        "metrics-stack",
        "sep-2",
        "status-text-1",
        "status-text-2"
      ]
    },
    "alert-ci": {
      "type": "Alert",
      "props": {
        "type": "error",
        "title": "🔴 CI Mirror Sync Failure",
        "message": "The `Sync from upstream` mirror job is stuck on both aeon-agent & miroshark-aeon. Failing since 06-15 12:04, no green since. The upstream mirror is not pulling latest."
      },
      "children": []
    },
    "sep-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "metrics-stack": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md"
      },
      "children": [
        "stat-aeon",
        "stat-miroshark",
        "stat-stars"
      ]
    },
    "stat-aeon": {
      "type": "Stat",
      "props": {
        "label": "aeon-agent skill runs",
        "value": "30✓"
      },
      "children": []
    },
    "stat-miroshark": {
      "type": "Stat",
      "props": {
        "label": "miroshark-aeon skill runs",
        "value": "27✓"
      },
      "children": []
    },
    "stat-stars": {
      "type": "Stat",
      "props": {
        "label": "MiroShark stars (5d)",
        "value": "+25",
        "trend": "up"
      },
      "children": []
    },
    "sep-2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "status-text-1": {
      "type": "Text",
      "props": {
        "text": "Skill runs themselves are all green—it's the upstream mirror not pulling latest",
        "variant": "muted"
      },
      "children": []
    },
    "status-text-2": {
      "type": "Text",
      "props": {
        "text": "Quick fix, but the public mirrors are drifting",
        "variant": "body"
      },
      "children": []
    }
  }
}
