{
  "root": "card",
  "state": {},
  "elements": {
    "card": {
      "type": "Card",
      "props": {
        "title": "heartbeat"
      },
      "children": [
        "alert",
        "sep1",
        "explanation",
        "root_cause_section",
        "fix_section",
        "sep2",
        "health_section"
      ]
    },
    "alert": {
      "type": "Alert",
      "props": {
        "title": "scheduling smell, 2nd morning straight",
        "message": "war-room ran on yesterday's data again today",
        "type": "warning"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "explanation": {
      "type": "Text",
      "props": {
        "text": "Not a failure — product-pulse + bd-radar both succeeded (07:59 / 08:04). They just committed after war-room had already read them.",
        "variant": "body"
      }
    },
    "root_cause_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "rc_heading",
        "rc_text"
      ]
    },
    "rc_heading": {
      "type": "Heading",
      "props": {
        "text": "Root cause",
        "level": "h3"
      }
    },
    "rc_text": {
      "type": "Text",
      "props": {
        "text": "GitHub batched all three delayed crons and fired them together at 07:56. The 07:15→07:20→07:45 stagger collapsed — war-room raced its own inputs and lost. It fell back to the 06-12 digests.",
        "variant": "body"
      }
    },
    "fix_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "fix_heading",
        "fix_text"
      ]
    },
    "fix_heading": {
      "type": "Heading",
      "props": {
        "text": "Fix",
        "level": "h3"
      }
    },
    "fix_text": {
      "type": "Text",
      "props": {
        "text": "Push war-room to ~09:00 UTC. Real buffer past the observed 08:04 upstream finish, even when crons fire late. One-line change in aeon.yml.",
        "variant": "body"
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "health_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "health_heading",
        "health_text",
        "health_stats"
      ]
    },
    "health_heading": {
      "type": "Heading",
      "props": {
        "text": "Overall health",
        "level": "h3"
      }
    },
    "health_text": {
      "type": "Text",
      "props": {
        "text": "Everything else green",
        "variant": "lead"
      }
    },
    "health_stats": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "lg"
      },
      "children": [
        "stat_failed",
        "stat_stuck",
        "stat_prs"
      ]
    },
    "stat_failed": {
      "type": "Stat",
      "props": {
        "label": "Failed",
        "value": "0",
        "trend": "neutral"
      }
    },
    "stat_stuck": {
      "type": "Stat",
      "props": {
        "label": "Stuck",
        "value": "0",
        "trend": "neutral"
      }
    },
    "stat_prs": {
      "type": "Stat",
      "props": {
        "label": "Open PRs/issues",
        "value": "0",
        "trend": "neutral"
      }
    }
  }
}
