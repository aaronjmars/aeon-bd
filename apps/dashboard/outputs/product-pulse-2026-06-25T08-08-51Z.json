{
  "root": "card",
  "state": {},
  "elements": {
    "card": {
      "type": "Card",
      "props": {
        "title": "product-pulse"
      },
      "children": [
        "alert_status",
        "divider1",
        "details_stack",
        "divider2",
        "action"
      ]
    },
    "alert_status": {
      "type": "Alert",
      "props": {
        "title": "aeon-wc still dark",
        "message": "17 days, no commit since Jun 8",
        "type": "warning"
      }
    },
    "divider1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "details_stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "attr_badges",
        "context_text",
        "significance_text"
      ]
    },
    "attr_badges": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
