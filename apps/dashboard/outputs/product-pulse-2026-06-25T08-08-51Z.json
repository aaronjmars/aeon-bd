      "children": [
        "badge_private",
        "badge_notci"
      ]
    },
    "badge_private": {
      "type": "Badge",
      "props": {
        "text": "Not a public repo",
        "variant": "secondary"
      }
    },
    "badge_notci": {
      "type": "Badge",
      "props": {
        "text": "Not CI",
        "variant": "secondary"
      }
    },
    "context_text": {
      "type": "Text",
      "props": {
        "text": "The private aeon core"
      }
    },
    "significance_text": {
      "type": "Text",
      "props": {
        "text": "Longest quiet period in the stack",
        "variant": "muted"
      }
    },
    "divider2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "action": {
      "type": "Text",
      "props": {
